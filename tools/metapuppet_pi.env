METAPUPPET_LEFT_CAMERA=1
METAPUPPET_RIGHT_CAMERA=0
METAPUPPET_PC_HOST=192.168.50.1
METAPUPPET_PC_PORT=5004
METAPUPPET_EYE_WIDTH=1536
METAPUPPET_EYE_HEIGHT=864
METAPUPPET_FPS=60

# Camera tuning is opt-in. Empty values preserve libcamera AWB/AE/autofocus.
# Copy the values recorded by the active stereo calibration when a fixed
# colour/exposure/lens contract is required.
MPS_CAMERA_AWB_GAINS=
MPS_CAMERA_SHUTTER_US=
MPS_CAMERA_ANALOG_GAIN=
MPS_CAMERA_LEFT_LENS_POSITION=
MPS_CAMERA_RIGHT_LENS_POSITION=

# H.264 settings for the GStreamer v4l2 path. Unsupported enhanced controls
# are reported and fall back to the prior bitrate-only hardware pipeline.
MPS_H264_BITRATE_KBPS=8000
MPS_V4L2_CBR=1
MPS_H264_INTRA_REFRESH=1
MPS_H264_SLICE_MAX_SIZE=0
